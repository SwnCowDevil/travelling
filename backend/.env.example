# Copy this file to .env and fill values locally. Never commit real secrets.
TRAVEL_AMAP_KEY=
TRAVEL_AMAP_SECRET=

TRAVEL_WECHAT_APP_ID=
TRAVEL_WECHAT_APP_SECRET=

TRAVEL_AI_BASE_URL=https://api.deepseek.com
TRAVEL_AI_MODEL=deepseek-v4-pro
TRAVEL_AI_FAST_MODEL=deepseek-v4-flash
TRAVEL_AI_API_KEY=
# Generate once: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TRAVEL_AI_ENCRYPTION_KEY=

# Replace these development values before deployment.
TRAVEL_JWT_SECRET=
TRAVEL_DATABASE_URL=sqlite:///./data/travel.db
