<view class="page"><loading-stage wx:if="{{loading}}" compact="{{true}}" text="正在加载攻略详情…"/><view wx:elif="{{error}}" class="empty">{{error}}</view><block wx:else><view class="hero"><text class="title">{{draft.destination_snapshot.name}}</text><text class="subtitle">{{draft.generation_mode==='deep'?'深度攻略':'快速攻略'}} · 你的可编辑副本</text></view><view class="actions {{editing ? 'is-editing' : ''}}"><button wx:if="{{!editing}}" class="primary" bindtap="edit">编辑攻略</button><block wx:else><button class="primary" loading="{{saving}}" bindtap="save">保存修改</button><button bindtap="cancel">取消</button></block><button class="danger" bindtap="remove">删除收藏</button></view><view class="section"><text class="heading">🚗 怎么去</text><block wx:for="{{draft.payload.transport}}" wx:key="index"><input disabled="{{!editing}}" value="{{item}}" data-field="transport[{{index}}]" bindinput="input"/></block></view><view class="section"><text class="heading">🌤️ 天气</text><block wx:for="{{draft.payload.weather}}" wx:key="index"><input disabled="{{!editing}}" value="{{item}}" data-field="weather[{{index}}]" bindinput="input"/></block></view><view class="section"><text class="heading">🎒 行李清单</text><block wx:for="{{draft.payload.packing}}" wx:key="index"><input disabled="{{!editing}}" value="{{item}}" data-field="packing[{{index}}]" bindinput="input"/></block></view><view class="section"><text class="heading">⚠️ 注意事项</text><block wx:for="{{draft.payload.cautions}}" wx:key="index"><input disabled="{{!editing}}" value="{{item}}" data-field="cautions[{{index}}]" bindinput="input"/></block></view><view class="section"><text class="heading">✨ 推荐玩法</text><block wx:for="{{draft.payload.highlights}}" wx:key="index"><input disabled="{{!editing}}" value="{{item}}" data-field="highlights[{{index}}]" bindinput="input"/></block></view><view class="section"><text class="heading">🍜 当地美食</text><view wx:for="{{draft.payload.foods}}" wx:key="index" class="food"><input disabled="{{!editing}}" value="{{item.name}}" data-field="foods[{{index}}].name" bindinput="input"/><input disabled="{{!editing}}" value="{{item.description}}" data-field="foods[{{index}}].description" bindinput="input"/><input disabled="{{!editing}}" value="{{item.area}}" data-field="foods[{{index}}].area" bindinput="input"/><input disabled="{{!editing}}" value="{{item.average_price}}" data-field="foods[{{index}}].average_price" bindinput="input"/></view></view><view class="section"><text class="heading">🗓️ 按天攻略</text><view wx:for="{{draft.payload.itinerary}}" wx:key="day" class="day"><input disabled="{{!editing}}" value="{{item.theme}}" data-field="itinerary[{{index}}].theme" bindinput="input"/><input disabled="{{!editing}}" value="{{item.morning}}" data-field="itinerary[{{index}}].morning" bindinput="input"/><input disabled="{{!editing}}" value="{{item.afternoon}}" data-field="itinerary[{{index}}].afternoon" bindinput="input"/><input disabled="{{!editing}}" value="{{item.evening}}" data-field="itinerary[{{index}}].evening" bindinput="input"/><input disabled="{{!editing}}" value="{{item.transport}}" data-field="itinerary[{{index}}].transport" bindinput="input"/><input disabled="{{!editing}}" value="{{item.caution}}" data-field="itinerary[{{index}}].caution" bindinput="input"/></view></view></block></view>
