.page{min-height:100vh;padding:24rpx;background:#f5f7f6;box-sizing:border-box;color:#1f302c}.hero{padding:18rpx 8rpx 24rpx}.title,.subtitle,.heading{display:block}.title{font-size:40rpx;font-weight:800}.subtitle{margin-top:10rpx;color:#71807b;font-size:22rpx}.actions{display:flex;gap:14rpx;margin-bottom:20rpx;flex-wrap:wrap}.actions button{margin:0;padding:0 24rpx;border-radius:999rpx;background:#fff;color:#1f302c;font-size:23rpx}.actions .primary{background:#1bb28a;color:#fff}.actions .danger{color:#d76060}.section{margin-bottom:18rpx;padding:24rpx;border-radius:24rpx;background:#fff;box-shadow:0 6rpx 20rpx rgba(0,0,0,.04)}.heading{margin-bottom:14rpx;font-size:27rpx;font-weight:800}input{display:block;min-height:52rpx;margin-top:10rpx;padding:8rpx 12rpx;border-radius:12rpx;background:#f7faf9;font-size:23rpx;box-sizing:border-box}.food,.day{margin-top:14rpx;padding:12rpx;border-left:5rpx solid #1bb28a;background:#f7faf9}.empty{padding:160rpx 20rpx;text-align:center;color:#89938f}
