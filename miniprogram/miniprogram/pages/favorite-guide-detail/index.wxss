.page{min-height:100vh;padding:24rpx;background:#f5f7f6;box-sizing:border-box;color:#1f302c}.hero{padding:18rpx 8rpx 24rpx}.title,.subtitle,.heading{display:block}.title{font-size:40rpx;font-weight:800}.subtitle{margin-top:10rpx;color:#71807b;font-size:22rpx}.actions{display:flex;gap:16rpx;margin-bottom:20rpx;flex-wrap:wrap}.actions button{display:flex;align-items:center;justify-content:center;flex:1;height:76rpx;margin:0;padding:0;border:2rpx solid #d7e3df;border-radius:18rpx;background:#fff;color:#52625e;font-size:25rpx;font-weight:700;box-sizing:border-box}.actions button:after{border:0}.actions button:active{transform:scale(.98)}.actions .primary{border-color:#1bb28a;background:#1bb28a;color:#fff;box-shadow:0 8rpx 18rpx rgba(27,178,138,.2)}.actions .danger{border:2rpx solid #d76060;background:#fff;color:#d76060}.actions.is-editing .danger{flex-basis:100%}.section{margin-bottom:18rpx;padding:24rpx;border-radius:24rpx;background:#fff;box-shadow:0 6rpx 20rpx rgba(0,0,0,.04)}.heading{margin-bottom:14rpx;font-size:27rpx;font-weight:800}input{display:block;min-height:52rpx;margin-top:10rpx;padding:8rpx 12rpx;border-radius:12rpx;background:#f7faf9;font-size:23rpx;box-sizing:border-box}.food,.day{margin-top:14rpx;padding:12rpx;border-left:5rpx solid #1bb28a;background:#f7faf9}.empty{padding:160rpx 20rpx;text-align:center;color:#89938f}
