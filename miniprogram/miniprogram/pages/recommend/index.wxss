.recommend-page{min-height:100vh;background:#f4f5f7;color:#1f2329;padding-bottom:44rpx;box-sizing:border-box}
.recommend-hero{position:relative;overflow:hidden;padding:34rpx 40rpx 42rpx;background:linear-gradient(135deg,#1bb28a,#23c79b,#19c2a0);background-size:260% 260%;color:#fff;border-radius:0 0 44rpx 44rpx;animation:gradient-shift 10s ease infinite}
.hero-title,.hero-subtitle{position:relative;z-index:2;display:block}.hero-title{font-size:44rpx;font-weight:700;letter-spacing:1rpx}.hero-subtitle{margin-top:8rpx;margin-bottom:30rpx;font-size:25rpx;opacity:.92}
.origin-row{position:relative;z-index:2;display:flex;align-items:center;min-height:76rpx;padding:0 20rpx;border-radius:24rpx;background:rgba(255,255,255,.18);color:#fff;font-size:27rpx;box-sizing:border-box}.origin-icon{font-size:28rpx}.origin-prefix{margin-left:8rpx;opacity:.94}.origin-name{max-width:250rpx;overflow:hidden;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.origin-switch{margin-left:auto;padding:8rpx 18rpx;border-radius:999rpx;background:rgba(255,255,255,.24);font-size:23rpx;white-space:nowrap}.origin-row:active .origin-switch{transform:scale(.95)}
.hero-orb{position:absolute;border-radius:50%;background:rgba(255,255,255,.11)}.hero-orb-one{width:280rpx;height:280rpx;right:-72rpx;top:-90rpx;animation:orb-float 8s ease-in-out infinite}.hero-orb-two{width:220rpx;height:220rpx;left:-80rpx;bottom:-120rpx;animation:orb-float 10s ease-in-out infinite reverse}
.filter-wrap{position:relative;z-index:20;background:#fff;box-shadow:0 4rpx 28rpx rgba(0,0,0,.06)}.filter-bar{display:flex;height:92rpx;border-bottom:1rpx solid #eceef1}.filter-trigger{position:relative;flex:1;display:flex;align-items:center;justify-content:center;gap:4rpx;font-size:25rpx;color:#646a73;white-space:nowrap}.filter-trigger.active{color:#159c77;font-weight:600}.filter-trigger.active:after{content:"";position:absolute;left:50%;bottom:-1rpx;width:32rpx;height:4rpx;transform:translateX(-50%);border-radius:4rpx;background:#1bb28a}.arrow{font-size:18rpx;transition:transform .25s}.filter-trigger.active .arrow{transform:rotate(180deg)}.count{min-width:24rpx;height:24rpx;padding:0 5rpx;border-radius:12rpx;background:#1bb28a;color:#fff;font-size:17rpx;line-height:24rpx;text-align:center;box-sizing:border-box}
.filter-panel{position:absolute;left:0;right:0;top:92rpx;max-height:70vh;overflow-y:auto;padding:30rpx 32rpx 34rpx;background:#fff;box-shadow:0 20rpx 40rpx rgba(0,0,0,.09);box-sizing:border-box;-webkit-overflow-scrolling:touch;animation:panel-in .24s ease both}.panel-title{display:block;margin-bottom:20rpx;font-size:23rpx;color:#9aa0a6}.panel-title-space{margin-top:28rpx}.month-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16rpx}.month-option{padding:20rpx 0;border-radius:20rpx;background:#f0f1f3;color:#646a73;font-size:26rpx;text-align:center}.month-option.selected{background:#1bb28a;color:#fff;font-weight:600}.option-grid{display:flex;flex-wrap:wrap;gap:18rpx}.option{padding:15rpx 30rpx;border:1rpx solid transparent;border-radius:999rpx;background:#f0f1f3;color:#646a73;font-size:25rpx}.option.selected{border-color:#1bb28a;background:#e6f7f2;color:#159c77;font-weight:600}.option.best.selected{border-color:#ff9f43;background:#fff1e3;color:#ff9f43}.advanced-hint{display:block;margin-top:28rpx;color:#9aa0a6;font-size:22rpx}.panel-actions{display:flex;gap:20rpx;margin-top:28rpx}.panel-actions button{display:flex;align-items:center;justify-content:center;flex:1;height:76rpx;padding:0;border:0;border-radius:20rpx;box-sizing:border-box;font-size:26rpx}.panel-actions button:after{border:0}.reset-button{background:#f0f1f3;color:#646a73}.confirm-button{background:#1bb28a;color:#fff}
.custom-days-row{display:flex;align-items:center;gap:12rpx;margin-top:18rpx}.custom-days-row input{min-width:0;flex:1;height:68rpx;padding:0 18rpx;border-radius:16rpx;background:#f2f4f5;font-size:24rpx;box-sizing:border-box}.custom-days-row button{display:flex;align-items:center;justify-content:center;width:112rpx;height:68rpx;margin:0;padding:0;border:0;border-radius:16rpx;font-size:23rpx}.custom-days-row button:after{border:0}.custom-days-cancel{background:#f0f1f3;color:#646a73}.custom-days-confirm{background:#1bb28a;color:#fff}
.filter-mask{position:fixed;z-index:15;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,.3)}
.filter-summary{position:relative;z-index:2;width:100%;white-space:nowrap;background:#f4f5f7}.summary-row{display:inline-flex;gap:14rpx;padding:20rpx 32rpx 8rpx}.summary-chip{display:flex;align-items:center;gap:10rpx;padding:10rpx 20rpx;border-radius:999rpx;background:#e6f7f2;color:#159c77;font-size:23rpx}.chip-close{font-size:28rpx;opacity:.65}
.cta-wrap{display:flex;flex-direction:column;gap:22rpx;padding:14rpx 32rpx 26rpx}.custom-guide-card,.quick-recommend-card{padding:26rpx;border-radius:24rpx;background:#fff;box-shadow:0 6rpx 20rpx rgba(0,0,0,.05);text-align:left}.recommend-cta{display:flex;align-items:center;justify-content:center;gap:14rpx;width:100%;height:100rpx;border:0;border-radius:28rpx;background:linear-gradient(135deg,#1bb28a,#23c79b);box-shadow:0 12rpx 36rpx rgba(27,178,138,.32);color:#fff;font-size:31rpx;font-weight:700;letter-spacing:2rpx}.recommend-cta:after{border:0}.recommend-cta:active{transform:scale(.98)}.recommend-cta.loading{opacity:.86;letter-spacing:0}.cta-spinner{width:32rpx;height:32rpx;border:5rpx solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}
.custom-title,.quick-recommend-title{display:block;margin-bottom:14rpx;font-size:27rpx;font-weight:800}.quick-recommend-hint{display:block;color:#71807b;font-size:23rpx}.quick-recommend-card .recommend-cta{margin-top:22rpx}.custom-input-row{display:flex;gap:12rpx}.custom-input-row input{min-width:0;flex:1;padding:0 18rpx;height:68rpx;border-radius:16rpx;background:#f2f7f5;font-size:23rpx}.custom-input-row button{margin:0;padding:0 20rpx;border-radius:16rpx;background:#1bb28a;color:#fff;font-size:22rpx;line-height:68rpx}.custom-candidate{margin-top:12rpx;padding:16rpx;border-radius:14rpx;background:#f7faf9}.custom-candidate text{display:block;font-size:23rpx}.custom-candidate text:last-child,.custom-message{margin-top:5rpx;color:#71807b;font-size:19rpx}.custom-message{display:block;margin-top:12rpx}
.recommend-results{padding:0 32rpx}.results-title{display:flex;align-items:baseline;gap:10rpx;margin:2rpx 4rpx 22rpx;font-size:28rpx;font-weight:700}.results-basis{color:#9aa0a6;font-size:22rpx;font-weight:400}.ai-notice,.fallback-notice{margin-bottom:22rpx;padding:18rpx 22rpx;border-radius:14rpx;font-size:23rpx}.ai-notice{border-left:6rpx solid #7557d8;background:#f2efff;color:#523d9e}.notice-title,.notice-copy{display:block}.notice-title{font-weight:800}.notice-copy{margin-top:6rpx;color:#71649d;font-size:20rpx}.fallback-notice{border-left:6rpx solid #ff9f43;background:#fff1e3;color:#a35a12}.skeleton-card{height:276rpx;margin-bottom:24rpx;border-radius:32rpx;background:linear-gradient(100deg,#eef0f2 30%,#f8f9fa 50%,#eef0f2 70%);background-size:200% 100%;animation:shimmer 1.2s infinite}.empty-state{display:flex;flex-direction:column;align-items:center;gap:16rpx;padding:70rpx 0;color:#9aa0a6;font-size:25rpx}.empty-icon{font-size:58rpx}.next-button{height:78rpx;margin-top:16rpx;border:2rpx solid #1bb28a;border-radius:24rpx;background:#fff;color:#159c77;font-size:27rpx}.next-button:after{border:0}
@keyframes gradient-shift{0%{background-position:0 50%}50%{background-position:100% 50%}100%{background-position:0 50%}}
@keyframes orb-float{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-16rpx) scale(1.06)}}
@keyframes panel-in{from{opacity:0;transform:translateY(-12rpx)}to{opacity:1;transform:translateY(0)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes shimmer{to{background-position:-200% 0}}
