<view class="page"><view class="hero"><text class="eyebrow">一键发现好去处</text><text class="title">{{filters.month}} 月，从哪里出发？</text><origin-picker id="origin" value="{{origin}}" bind:change="onOrigin"/></view><view class="quick"><text>景色</text><text>人文</text><text>人少</text><text bindtap="toggleMore">更多筛选</text></view><van-button round block color="#16845B" bind:click="recommend">一键推荐</van-button><loading-stage wx:if="{{loading}}" text="{{stage}}"/><view wx:if="{{fallback}}" class="notice">AI 暂不可用，已使用可靠规则推荐</view><recommend-card wx:for="{{items}}" wx:key="code" item="{{item}}" bind:open="openDetail"/><van-button wx:if="{{sessionId && !loading}}" plain round block color="#16845B" bind:click="next">换一批</van-button><van-popup show="{{showMore}}" position="bottom" round custom-style="height:55%"><view class="sheet">距离、预算、天数、淡旺季和交通均可不选</view></van-popup></view>
