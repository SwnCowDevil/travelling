<view class="recommend-page">
  <view class="recommend-hero">
    <view class="hero-orb hero-orb-one"></view>
    <view class="hero-orb hero-orb-two"></view>
    <text class="hero-title">旅行推荐</text>
    <text class="hero-subtitle">按月份和你的位置，一键找到最适合去的地方</text>
    <view class="origin-row" bindtap="chooseOrigin">
      <text class="origin-icon">📍</text>
      <text class="origin-prefix">所在地区：</text>
      <text class="origin-name">{{resolvingOrigin ? '正在识别地点…' : (origin.name || '请选择')}}</text>
      <text class="origin-switch">{{resolvingOrigin ? '请稍候' : '切换定位'}}</text>
    </view>
  </view>

  <view class="filter-wrap">
    <view class="filter-bar">
      <view id="filter-month" class="filter-trigger {{activePanel === 'month' ? 'active' : ''}}" data-panel="month" bindtap="togglePanel"><text>{{filters.month}}月</text><text class="arrow">▾</text></view>
      <view id="filter-season" class="filter-trigger {{activePanel === 'season' ? 'active' : ''}}" data-panel="season" bindtap="togglePanel"><text>季节</text><text class="count" wx:if="{{filters.seasons.length}}">{{filters.seasons.length}}</text><text class="arrow">▾</text></view>
      <view id="filter-crowd" class="filter-trigger {{activePanel === 'crowd' ? 'active' : ''}}" data-panel="crowd" bindtap="togglePanel"><text>人流</text><text class="count" wx:if="{{filters.crowd.length}}">{{filters.crowd.length}}</text><text class="arrow">▾</text></view>
      <view id="filter-pref" class="filter-trigger {{activePanel === 'preferences' ? 'active' : ''}}" data-panel="preferences" bindtap="togglePanel"><text>偏好</text><text class="count" wx:if="{{filters.preferences.length}}">{{filters.preferences.length}}</text><text class="arrow">▾</text></view>
      <view id="filter-more" class="filter-trigger {{activePanel === 'more' ? 'active' : ''}}" data-panel="more" bindtap="togglePanel"><text>更多</text><text class="count" wx:if="{{filters.categories.length || filters.bestOnly || filters.distanceRange || filters.days}}">{{filters.categories.length + (filters.bestOnly ? 1 : 0) + (filters.distanceRange ? 1 : 0) + (filters.days ? 1 : 0)}}</text><text class="arrow">▾</text></view>
    </view>

    <view class="filter-panel" wx:if="{{activePanel}}">
      <block wx:if="{{activePanel === 'month'}}">
        <text class="panel-title">选择出行月份</text>
        <view class="month-grid">
          <view wx:for="{{months}}" wx:key="*this" class="month-option {{filters.month === item ? 'selected' : ''}}" data-month="{{item}}" bindtap="selectMonth">{{item}}月</view>
        </view>
      </block>
      <block wx:if="{{activePanel === 'season'}}">
        <text class="panel-title">季节（可多选）</text>
        <view class="option-grid"><view wx:for="{{filterOptions.season}}" wx:key="value" class="option {{item.selected ? 'selected' : ''}}" data-group="seasons" data-value="{{item.value}}" bindtap="toggleOption">{{item.value}}</view></view>
      </block>
      <block wx:if="{{activePanel === 'crowd'}}">
        <text class="panel-title">人流（可多选）</text>
        <view class="option-grid"><view wx:for="{{filterOptions.crowd}}" wx:key="value" class="option {{item.selected ? 'selected' : ''}}" data-group="crowd" data-value="{{item.value}}" bindtap="toggleOption">{{item.value}}</view></view>
      </block>
      <block wx:if="{{activePanel === 'preferences'}}">
        <text class="panel-title">偏好（可多选）</text>
        <view class="option-grid"><view wx:for="{{filterOptions.preferences}}" wx:key="value" class="option {{item.selected ? 'selected' : ''}}" data-group="preferences" data-value="{{item.value}}" bindtap="toggleOption">{{item.value}}</view></view>
      </block>
      <block wx:if="{{activePanel === 'more'}}">
        <text class="panel-title">距离所在地区</text>
        <view class="option-grid"><view wx:for="{{filterOptions.distance}}" wx:key="label" class="option {{item.selected ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="selectDistanceRange">{{item.label}}</view></view>
        <text class="panel-title panel-title-space">游玩天数</text>
        <view class="option-grid">
          <view wx:for="{{filterOptions.days}}" wx:key="value" class="option {{item.selected ? 'selected' : ''}}" data-days="{{item.value}}" bindtap="selectDays">{{item.value}}天</view>
          <view class="option {{filterOptions.customDaysSelected ? 'selected' : ''}}" bindtap="openCustomDays"><text wx:if="{{filterOptions.customDaysSelected}}">{{filters.days}}天</text><text wx:else>自定义</text></view>
        </view>
        <view class="custom-days-row" wx:if="{{customDaysVisible}}">
          <input type="number" maxlength="2" placeholder="输入1–15" value="{{customDaysInput}}" bindinput="inputCustomDays"/>
          <button class="custom-days-cancel" bindtap="cancelCustomDays">取消</button>
          <button class="custom-days-confirm" bindtap="confirmCustomDays">确定</button>
        </view>
        <text class="advanced-hint">可自定义1–15天；不选时攻略默认2天</text>
        <text class="panel-title panel-title-space">最推荐</text>
        <view class="option-grid"><view class="option best {{filters.bestOnly ? 'selected' : ''}}" bindtap="toggleBest">⭐ 优先好评最高</view></view>
        <text class="panel-title panel-title-space">分类（可多选）</text>
        <view class="option-grid"><view wx:for="{{filterOptions.categories}}" wx:key="value" class="option {{item.selected ? 'selected' : ''}}" data-group="categories" data-value="{{item.value}}" bindtap="toggleOption">{{item.value}}</view></view>
        <text class="advanced-hint">预算与交通条件可继续在此扩展</text>
        <view class="panel-actions"><button class="reset-button" bindtap="resetFilters">重置</button><button class="confirm-button" bindtap="closeFilters">确定</button></view>
      </block>
    </view>
  </view>

  <view class="filter-mask" wx:if="{{activePanel}}" bindtap="closeFilters"></view>

  <scroll-view id="filter-summary" class="filter-summary" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="summary-row">
      <view wx:for="{{summaries}}" wx:key="label" class="summary-chip"><text>{{item.label}}</text><text wx:if="{{item.key !== 'month'}}" class="chip-close" data-key="{{item.key}}" data-value="{{item.value}}" bindtap="removeSummary">×</text></view>
    </view>
  </scroll-view>

  <view class="cta-wrap">
    <view class="custom-guide-card"><text class="custom-title">🧭 想去哪里？</text><view class="custom-input-row"><input placeholder="输入景点、城市或目的地" value="{{customKeyword}}" bindinput="inputCustomDestination"/><button loading="{{searchingCustom}}" bindtap="searchCustomDestination">生成攻略</button></view><view wx:for="{{customCandidates}}" wx:key="amap_poi_id" class="custom-candidate" bindtap="selectCustomDestination" data-item="{{item}}"><text>{{item.name}}</text><text>{{item.region_name}} {{item.address}}</text></view><text wx:if="{{customSearchMessage}}" class="custom-message">{{customSearchMessage}}</text></view>
    <view class="quick-recommend-card">
      <text class="quick-recommend-title">✨ 一键推荐</text>
      <text class="quick-recommend-hint">不知道去哪？试试一键推荐</text>
      <button id="recommend-cta" class="recommend-cta {{loading ? 'loading' : ''}}" disabled="{{loading}}" bindtap="recommend">
        <view wx:if="{{loading}}" class="cta-spinner"></view>
        <text>{{loading ? '正在推荐' : '🚀 一键推荐'}}</text>
      </button>
    </view>
  </view>

  <view id="recommend-results" class="recommend-results">
    <view class="results-title"><text>为你推荐</text><text class="results-basis">· 基于 {{filters.month}}月 / {{origin.name || '未选出发地'}}</text></view>
    <view wx:if="{{aiGenerated}}" class="ai-notice"><text class="notice-title">AI 生成建议</text><text class="notice-copy">行程与实时信息请核验</text></view>
    <view wx:if="{{fallback}}" class="fallback-notice">AI 未参与，已使用可靠规则推荐</view>
    <loading-stage wx:if="{{loading}}" text="{{stage}}"/>
    <view wx:if="{{loading}}" class="skeleton-list"><view class="skeleton-card"></view><view class="skeleton-card"></view><view class="skeleton-card"></view></view>
    <block wx:else>
      <recommend-card wx:for="{{items}}" wx:key="code" item="{{item}}" bind:open="openDetail" bind:status="onCardStatus"/>
      <view wx:if="{{!items.length}}" class="empty-state"><text class="empty-icon">🧭</text><text>选好条件，开始发现下一站</text></view>
      <button wx:if="{{sessionId && hasMore}}" class="next-button" bindtap="next">换一批</button>
    </block>
  </view>
</view>
