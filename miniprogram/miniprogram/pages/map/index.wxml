<view class="page">
  <view class="topbar">
    <view class="stats"><text class="big">{{items.length}}</text><text>个区域已点亮</text></view>
    <view class="mode-switch"><text class="mode-option {{mode === 'map' ? 'active' : ''}}" bindtap="toggleMode">地图</text><text class="mode-option {{mode === 'list' ? 'active' : ''}}" bindtap="toggleMode">列表</text></view>
  </view>
  <view class="filters"><text wx:for="{{statuses}}" wx:key="label" class="filter {{status === item.key ? 'active' : ''}}" data-status="{{item.key}}" bindtap="filter">{{item.label}}</text></view>
  <view class="map-title"><view><text wx:if="{{parentCode}}" class="back-country" bindtap="backToCountry">‹ 全国</text><text>{{parentCode ? '省内城市足迹' : '中国旅行足迹'}}</text></view><text>{{parentCode ? '点击城市查看列表' : '点击省份下钻到城市'}}</text></view>
  <view hidden="{{mode === 'list'}}" class="map-mode">
    <view class="map-stage"><canvas type="2d" id="footprint-canvas" canvas-id="footprint-canvas" bindtap="tapMap"></canvas><view class="map-legend"><text>● 去过</text><text>● 想再去</text><text>● 想去</text></view></view>
  </view>
  <view hidden="{{mode === 'map'}}" class="list-mode">
    <view wx:if="{{!mapAvailable}}" class="notice">地图数据暂不可用，已切换为列表模式</view>
    <view class="region card" wx:for="{{visible}}" wx:key="region_code" data-code="{{item.region_code}}" data-level="{{item.level}}" bindtap="drill"><view><text class="name">{{item.name}}</text><text class="direct" wx:if="{{item.direct_status}}">{{item.direct_status}}</text></view><text>{{item.visit_count}} 次到访</text></view>
  </view>
  <view class="visit-entry" bindtap="openVisits"><text>🗓️ 到访记录</text><text>›</text></view>
</view>
