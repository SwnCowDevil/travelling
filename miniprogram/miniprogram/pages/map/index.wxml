<view class="page"><view class="stats card"><text class="big">{{items.length}}</text><text>个区域已点亮</text><van-button size="small" bind:click="openVisits">到访记录</van-button></view><view class="filters"><text wx:for="{{statuses}}" wx:key="label" data-status="{{item.key}}" bindtap="filter">{{item.label}}</text></view><view wx:if="{{!mapAvailable}}" class="notice">地图暂不可用，仍可通过列表管理足迹</view><view class="region card" wx:for="{{visible}}" wx:key="region_code" data-code="{{item.region_code}}" bindtap="drill"><view><text class="name">{{item.name}}</text><text class="direct" wx:if="{{item.direct_status}}">{{item.direct_status}}</text></view><text>{{item.visit_count}} 次到访</text></view></view>
