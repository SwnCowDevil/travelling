.page{min-height:100vh;padding:28rpx 28rpx 48rpx;box-sizing:border-box;background:#f4f7f6;color:#173a37}.topbar{display:flex;align-items:center;justify-content:space-between}.stats{display:flex;align-items:baseline;gap:12rpx}.big{font-size:54rpx;font-weight:800;color:#16845b}.mode-switch{display:flex;padding:6rpx;border-radius:999rpx;background:#dfe8e5}.mode-option{padding:12rpx 20rpx;border-radius:999rpx;color:#60716e;font-size:23rpx}.mode-option.active{background:#173a37;color:#fff;font-weight:700}.filters{display:flex;gap:12rpx;overflow:hidden;margin:24rpx 0}.filter{flex-shrink:0;padding:12rpx 20rpx;border-radius:999rpx;background:#e8f5ee;color:#49615c;font-size:23rpx}.filter.active{background:#16845b;color:#fff}.map-title{display:flex;align-items:baseline;justify-content:space-between;margin:10rpx 4rpx 18rpx}.map-title text:last-child{font-size:21rpx;color:#71807b}.map-title view{display:flex;align-items:center;gap:12rpx}.map-title view text:last-child{font-size:29rpx;font-weight:800;color:#173a37}.back-country{font-size:23rpx!important;font-weight:700!important;color:#16845b!important;padding-right:12rpx;border-right:1rpx solid #d5e1de}.map-stage{position:relative;overflow:hidden;height:620rpx;border-radius:34rpx;background:#0b1d2b;box-shadow:0 18rpx 42rpx rgba(13,45,61,.24)}.map-stage canvas{width:100%;height:100%}.map-legend{position:absolute;left:20rpx;bottom:20rpx;display:flex;gap:15rpx;padding:12rpx 16rpx;border-radius:16rpx;background:rgba(4,16,25,.7);color:#c9f4ee;font-size:19rpx}.map-legend text:nth-child(1){color:#20d8cf}.map-legend text:nth-child(2){color:#159c9a}.map-legend text:nth-child(3){color:#83d9cb}.list-mode{margin-top:6rpx}.region{display:flex;justify-content:space-between;padding:28rpx;margin-bottom:22rpx}.name{font-weight:700;margin-right:12rpx}.direct,.notice{color:#8a6a18}.notice{padding:20rpx;background:#fff8dc;border-radius:18rpx;margin-bottom:20rpx}.visit-entry{display:flex;justify-content:space-between;align-items:center;margin-top:28rpx;padding:24rpx 28rpx;border-radius:24rpx;background:#fff;box-shadow:0 6rpx 20rpx rgba(0,0,0,.05);font-size:26rpx;font-weight:700}
