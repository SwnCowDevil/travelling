<view class="page"><view class="hero"><text class="title">收藏攻略</text><text class="subtitle">你保存并可以自由修改的旅行计划</text></view><loading-stage wx:if="{{loading}}" compact="{{true}}" text="正在加载收藏攻略…"/><view wx:elif="{{error}}" class="empty">{{error}}</view><view wx:elif="{{!items.length}}" class="empty">还没有收藏攻略，去目的地详情页收藏一份吧</view><view wx:else><view wx:for="{{items}}" wx:key="id" class="card" bindtap="openFavorite" data-id="{{item.id}}"><text class="emoji">{{item.destination_snapshot.emoji}}</text><view class="copy"><text class="name">{{item.destination_snapshot.name}}</text><text class="summary">{{item.destination_snapshot.summary}}</text><text class="meta">{{item.generation_mode==='deep'?'深度攻略':'快速攻略'}} · 已保存</text></view><text class="arrow">›</text></view></view></view>
