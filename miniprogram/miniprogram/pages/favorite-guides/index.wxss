.page{min-height:100vh;padding:28rpx 24rpx;background:#f5f7f6;box-sizing:border-box}.hero{padding:20rpx 8rpx 30rpx}.title,.subtitle,.name,.summary,.meta{display:block}.title{font-size:42rpx;font-weight:800;color:#1f302c}.subtitle{margin-top:10rpx;color:#71807b;font-size:23rpx}.card{display:flex;margin-bottom:18rpx;padding:26rpx;border-radius:26rpx;background:#fff;align-items:center;box-shadow:0 7rpx 22rpx rgba(0,0,0,.05)}.emoji{margin-right:20rpx;font-size:46rpx}.copy{min-width:0;flex:1}.name{font-size:29rpx;font-weight:800;color:#1f302c}.summary{overflow:hidden;margin-top:8rpx;color:#71807b;font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}.meta{margin-top:12rpx;color:#159c77;font-size:20rpx}.arrow{color:#9aa0a6;font-size:42rpx}.empty{padding:150rpx 26rpx;text-align:center;color:#89938f;font-size:25rpx}
