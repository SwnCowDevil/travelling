<view class="page"><view class="card form"><text>当前：{{profile.mode==='personal'?'个人配置':'系统默认'}}</text><text wx:if="{{profile.maskedToken}}">Token {{profile.maskedToken}}</text><van-field type="password" value="{{form.token}}" data-field="token" bind:change="input" label="新 Token" placeholder="留存在本机输入框中，不回显"/><view class="toggle"><text>高级设置</text><van-switch checked="{{advanced}}" bind:change="toggle"/></view><block wx:if="{{advanced}}"><van-field value="{{form.base_url}}" data-field="base_url" bind:change="input" label="服务地址"/><van-field value="{{form.model}}" data-field="model" bind:change="input" label="模型"/><van-field value="{{form.group_note}}" data-field="group_note" bind:change="input" label="分组备注"/></block><van-button block round color="#16845B" loading="{{saving}}" bind:click="save">测试并保存</van-button><van-button block plain round bind:click="reset">恢复系统默认</van-button></view></view>
