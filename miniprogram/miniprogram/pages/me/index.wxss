.me-page{position:relative;min-height:100vh;padding-bottom:48rpx;background:#f4f5f7;color:#1f2329;box-sizing:border-box}.me-hero{position:relative;overflow:hidden;display:flex;align-items:center;gap:30rpx;padding:56rpx 40rpx 52rpx;background:linear-gradient(135deg,#1bb28a,#23c79b);color:#fff}.me-orb{position:absolute;right:-80rpx;top:-100rpx;width:300rpx;height:300rpx;border-radius:50%;background:rgba(255,255,255,.11);animation:me-orb 9s ease-in-out infinite}
.avatar{position:relative;z-index:2;display:flex;align-items:center;justify-content:center;width:132rpx;height:132rpx;margin:0;padding:0;overflow:hidden;border:4rpx solid rgba(255,255,255,.55);border-radius:50%;background:rgba(255,255,255,.23);line-height:132rpx;animation:avatar-float 4s ease-in-out infinite}.avatar:after{border:0}.avatar image{width:100%;height:100%;border-radius:50%}.avatar-default{font-size:60rpx}.profile-copy{position:relative;z-index:2;min-width:0}.profile-name,.profile-subtitle{display:block}.profile-name{font-size:38rpx;font-weight:700}.profile-subtitle{margin-top:8rpx;font-size:25rpx;opacity:.9}
.me-stats{display:flex;margin:28rpx 32rpx;border-radius:32rpx;background:#fff;box-shadow:0 4rpx 28rpx rgba(0,0,0,.06);animation:section-in .5s ease both}.stat-item{position:relative;flex:1;padding:28rpx 0;text-align:center}.stat-item+.stat-item:before{content:"";position:absolute;left:0;top:26rpx;bottom:26rpx;width:1rpx;background:#eceef1}.stat-number,.stat-label{display:block}.stat-number{color:#159c77;font-size:43rpx;font-weight:700}.stat-label{margin-top:5rpx;color:#9aa0a6;font-size:22rpx}
.menu-group{margin:0 32rpx;border-radius:32rpx;background:#fff;box-shadow:0 4rpx 28rpx rgba(0,0,0,.06);overflow:hidden;animation:section-in .55s ease both}.secondary-group{margin-top:28rpx}.menu-item{display:flex;align-items:center;min-height:94rpx;padding:0 30rpx;border-bottom:1rpx solid #eceef1;font-size:28rpx;box-sizing:border-box}.menu-item:last-child{border-bottom:0}.menu-item:active{background:#f0f1f3}.menu-icon{width:48rpx;margin-right:20rpx;font-size:32rpx;text-align:center}.menu-title{font-size:28rpx}.menu-copy{display:flex;min-width:0;flex:1;flex-direction:column}.menu-description{margin-top:3rpx;color:#9aa0a6;font-size:20rpx}.menu-arrow{margin-left:auto;color:#9aa0a6;font-size:40rpx;font-weight:300}.muted{color:#9aa0a6}.coming-tag{margin-left:auto;padding:5rpx 16rpx;border-radius:999rpx;background:#f0f1f3;color:#9aa0a6;font-size:19rpx}.stats-loading{position:fixed;left:50%;bottom:130rpx;padding:12rpx 24rpx;border-radius:999rpx;background:rgba(31,35,41,.78);color:#fff;font-size:21rpx;transform:translateX(-50%)}
@keyframes avatar-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8rpx)}}
@keyframes me-orb{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(18rpx) scale(1.06)}}
@keyframes section-in{from{opacity:0;transform:translateY(22rpx)}to{opacity:1;transform:translateY(0)}}
