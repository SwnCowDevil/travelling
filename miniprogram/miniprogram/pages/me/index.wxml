<view class="me-page">
  <view id="me-hero" class="me-hero">
    <view class="me-orb"></view>
    <button class="avatar" open-type="chooseAvatar" bind:chooseavatar="chooseAvatar">
      <image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill"/>
      <text wx:else class="avatar-default">👤</text>
    </button>
    <view class="profile-copy">
      <text class="profile-name">{{name}}</text>
      <text class="profile-subtitle">{{subtitle}}</text>
    </view>
  </view>

  <view id="me-stats" class="me-stats">
    <view class="stat-item"><text class="stat-number">{{stats.visited}}</text><text class="stat-label">去过</text></view>
    <view class="stat-item"><text class="stat-number">{{stats.want}}</text><text class="stat-label">想去</text></view>
    <view class="stat-item"><text class="stat-number">{{stats.avoid}}</text><text class="stat-label">不想去</text></view>
  </view>

  <view class="menu-group">
    <view class="menu-item" bindtap="openMap"><text class="menu-icon">🗺️</text><text class="menu-title">我的旅行地图</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="openVisits"><text class="menu-icon">📍</text><text class="menu-title">到访记录</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="openAI"><text class="menu-icon">✨</text><view class="menu-copy"><text class="menu-title">AI 设置</text><text class="menu-description">系统默认或个人 Token</text></view><text class="menu-arrow">›</text></view>
  </view>

  <view class="menu-group secondary-group">
    <view class="menu-item muted" bindtap="showComingSoon"><text class="menu-icon">🔔</text><text class="menu-title">消息通知</text><text class="coming-tag">待扩展</text></view>
    <view class="menu-item muted" bindtap="showComingSoon"><text class="menu-icon">👥</text><text class="menu-title">旅行伙伴</text><text class="coming-tag">待扩展</text></view>
    <view class="menu-item" bindtap="showComingSoon"><text class="menu-icon">⚙️</text><text class="menu-title">设置</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="showComingSoon"><text class="menu-icon">ℹ️</text><text class="menu-title">关于</text><text class="menu-arrow">›</text></view>
  </view>

  <view wx:if="{{loading}}" class="stats-loading">正在更新旅行数据…</view>
</view>
