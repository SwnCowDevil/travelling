.detail-page{min-height:100vh;padding:0 24rpx 60rpx;background:#f5f7f6;color:#1f302c;box-sizing:border-box}.hero{margin:0 -24rpx 24rpx;padding:64rpx 40rpx 44rpx;background:linear-gradient(135deg,#1bb28a,#23c79b);color:#fff;animation:rise .45s ease}.emoji{display:block;font-size:70rpx}.title{display:block;margin-top:12rpx;font-size:48rpx;font-weight:800}.summary{display:block;margin-top:12rpx;font-size:26rpx;line-height:1.55;opacity:.94}.rating{display:block;margin-top:14rpx;color:#fff2d8}.bold{display:block;font-weight:700}.meta{display:flex;margin-bottom:24rpx;padding:20rpx 8rpx;border-radius:28rpx;background:#fff;box-shadow:0 6rpx 24rpx rgba(0,0,0,.05)}.meta view{min-width:0;flex:1;padding:0 8rpx;text-align:center}.meta text{display:block;color:#9aa0a6;font-size:19rpx}.meta .bold{overflow:hidden;margin-top:7rpx;color:#1f302c;font-size:21rpx;text-overflow:ellipsis}.meta .green{color:#159c77}.section{margin-bottom:22rpx;padding:28rpx;border-radius:28rpx;background:#fff;box-shadow:0 6rpx 24rpx rgba(0,0,0,.05);animation:rise .5s ease both}.heading{margin-bottom:22rpx;border-left:7rpx solid #1bb28a;padding-left:14rpx;font-size:29rpx;font-weight:800}.heading-more{float:right;color:#159c77;font-size:19rpx;font-weight:500}.timeline{position:relative;display:flex;padding:0 0 22rpx 26rpx;border-left:2rpx solid #d8eee8}.dot{position:absolute;left:-8rpx;width:14rpx;height:14rpx;border-radius:50%;background:#1bb28a}.timeline text,.line{font-size:24rpx;line-height:1.55}.weather{white-space:nowrap}.weather-card{display:inline-flex;width:180rpx;margin-right:14rpx;padding:18rpx;border-radius:20rpx;background:#e8f7f2;flex-direction:column}.weather-card text{margin-top:6rpx;font-size:21rpx}.chips{display:flex;flex-wrap:wrap;gap:12rpx}.chips text{padding:10rpx 18rpx;border-radius:999rpx;background:#e8f7f2;color:#159c77;font-size:22rpx}.tip{display:flex;gap:16rpx;margin-top:14rpx;align-items:flex-start}.tip-number{display:flex;width:38rpx;height:38rpx;border-radius:50%;background:#fff1e3;color:#ff9f43;align-items:center;justify-content:center}.tip text:last-child{flex:1;font-size:24rpx;line-height:1.55}.food{margin-top:16rpx;padding:20rpx;border-radius:20rpx;background:#fff8f0}.food text{display:block;margin-top:8rpx;font-size:23rpx}.food-meta{margin-top:10rpx;color:#8b735d}.price-note{display:block;margin-top:16rpx;color:#9aa0a6;font-size:19rpx}.day{margin-top:20rpx;padding:22rpx;border-radius:22rpx;background:#f7faf9;border-left:7rpx solid #1bb28a}.day-title{margin-bottom:14rpx;font-size:27rpx;font-weight:800}.day text{display:block;margin-top:10rpx;font-size:22rpx;line-height:1.5}.period{display:inline;margin-right:14rpx;color:#159c77;font-weight:700}.day-meta{color:#69736f}.day .warn{color:#d77b25}.skeleton view{height:180rpx;margin:24rpx 0;border-radius:28rpx;background:linear-gradient(100deg,#e8ecea,#f7f8f7,#e8ecea);background-size:200%;animation:shimmer 1.2s infinite}.empty{padding:160rpx 20rpx;text-align:center;color:#9aa0a6}@keyframes rise{from{opacity:0;transform:translateY(20rpx)}to{opacity:1;transform:none}}@keyframes shimmer{to{background-position:-200% 0}}
.regenerate-card{display:flex;margin-bottom:24rpx;padding:24rpx 26rpx;border:2rpx solid #d8eee8;border-radius:26rpx;background:linear-gradient(135deg,#f7fffc,#ecf9f5);align-items:center;justify-content:space-between;gap:18rpx}.regenerate-card>view{min-width:0;flex:1}.regenerate-title,.regenerate-desc{display:block}.regenerate-title{font-size:25rpx;font-weight:800}.regenerate-desc{margin-top:7rpx;color:#71807b;font-size:19rpx;line-height:1.4}.regenerate-button{flex:none;margin:0;padding:0 22rpx;height:66rpx;border:0;border-radius:999rpx;background:#1bb28a!important;color:#fff!important;font-size:22rpx;font-weight:700;line-height:66rpx;box-shadow:0 8rpx 18rpx rgba(27,178,138,.22)}.regenerate-button::after{border:0}.regenerate-button[disabled]{opacity:.65}
