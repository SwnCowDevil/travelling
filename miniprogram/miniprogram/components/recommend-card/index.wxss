.recommend-card{margin-bottom:26rpx;overflow:hidden;border-radius:32rpx;background:#fff;box-shadow:0 4rpx 28rpx rgba(0,0,0,.06);animation:card-in .48s ease both}.recommend-card.marked{box-shadow:0 0 0 3rpx #e6f7f2,0 4rpx 28rpx rgba(0,0,0,.06)}
.card-main{padding:28rpx 28rpx 18rpx}.card-top{display:flex;align-items:center;gap:22rpx}.card-thumb{flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:108rpx;height:108rpx;border-radius:24rpx;font-size:52rpx;animation:thumb-float 3.5s ease-in-out infinite}.card-heading{min-width:0;flex:1}.card-name{display:block;font-size:32rpx;font-weight:700}.rating-row{display:flex;align-items:center;gap:10rpx;margin-top:4rpx}.stars{color:#ff9f43;font-size:21rpx;letter-spacing:1rpx}.score{color:#9aa0a6;font-size:20rpx}.tag-row{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:9rpx}.tag{padding:4rpx 12rpx;border-radius:10rpx;background:#e6f7f2;color:#159c77;font-size:19rpx}.tag.warning{background:#fff1e3;color:#ff9f43}.best-badge{align-self:flex-start;flex:0 0 auto;padding:8rpx 16rpx;border-radius:999rpx;background:linear-gradient(135deg,#ff9f43,#ffb870);box-shadow:0 6rpx 16rpx rgba(255,159,67,.3);color:#fff;font-size:20rpx;font-weight:700}
.card-summary{display:block;margin-top:20rpx;color:#646a73;font-size:23rpx;line-height:1.55}.detail-grid{display:flex;gap:20rpx;margin-top:22rpx}.detail-column{min-width:0;flex:1}.detail-label,.detail-value{display:block}.detail-label{color:#9aa0a6;font-size:20rpx}.detail-value{display:-webkit-box;overflow:hidden;margin-top:6rpx;color:#1f2329;font-size:22rpx;line-height:1.45;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.card-actions{display:flex;gap:14rpx;padding:0 28rpx 28rpx}.status-button{flex:1;height:66rpx;margin:0;padding:0;border:2rpx solid #eceef1;border-radius:20rpx;background:#fff;color:#646a73;font-size:23rpx;line-height:62rpx}.status-button:after{border:0}.status-button:active{transform:scale(.96)}.status-button.visited.selected{border-color:#4a90e2;background:#4a90e2;color:#fff}.status-button.want.selected{border-color:#1bb28a;background:#1bb28a;color:#fff}.status-button.avoid.selected{border-color:#c9cdd4;background:#c9cdd4;color:#fff}
@keyframes card-in{from{opacity:0;transform:translateY(28rpx)}to{opacity:1;transform:translateY(0)}}
@keyframes thumb-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-7rpx)}}
