.loading{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16rpx;padding:42rpx 24rpx;color:#557066;animation:appear .25s ease-out}
.loading-fox{display:block;width:160rpx;height:160rpx;flex:none}
.loading-copy{font-size:24rpx;line-height:1.5;text-align:center}
.loading.compact{gap:10rpx;padding:24rpx 16rpx}
.loading.compact .loading-fox{width:112rpx;height:112rpx}
.loading.compact .loading-copy{font-size:22rpx}
@keyframes appear{from{opacity:0;transform:translateY(8rpx)}to{opacity:1;transform:none}}
