.loading{display:flex;align-items:center;justify-content:center;padding:28rpx 24rpx;color:#557066;animation:appear .25s ease-out}
.loading-copy{font-size:24rpx;line-height:1.5;text-align:center}
.loading.compact{padding:18rpx 16rpx}
.loading.compact .loading-copy{font-size:22rpx}
@keyframes appear{from{opacity:0;transform:translateY(8rpx)}to{opacity:1;transform:none}}
