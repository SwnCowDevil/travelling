[Unit]
Description=Travel Recommendation FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=travel
Group=travel
WorkingDirectory=/opt/travelling/backend
EnvironmentFile=/etc/travelling/travel-api.env
ExecStart=/opt/travelling/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/travelling/backend/data

[Install]
WantedBy=multi-user.target
